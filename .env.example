# Local development only. Copy to .env for your own shell/session and never commit secrets.
DATABASE_URL=sqlite:///./youtube_bot_dashboard.db
LIVE_WORKER_POLL_SECONDS=0.25
LOG_LEVEL=INFO

# Configure one or both providers. Model IDs are deliberately not hard-coded.
GEMINI_API_KEY=
GEMINI_MODEL=

# Qwen through the OpenAI-compatible API endpoint chosen for your region/provider.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Required to accept messages from a trusted normalized-chat source.
# Use a long, random secret; send it as the X-Ingest-Key header over HTTPS.
INGEST_API_KEY=
