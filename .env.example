# Local development only. Copy to .env for your own shell/session and never commit secrets.
DATABASE_URL=sqlite:///./youtube_bot_dashboard.db
LIVE_WORKER_POLL_SECONDS=0.25
LOG_LEVEL=INFO

# Configure one or both providers. Model IDs are deliberately not hard-coded.
GEMINI_API_KEY=
GEMINI_MODEL=

# Qwen through the OpenAI-compatible API endpoint chosen for your region/provider.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Optional DeepSeek Chat Completions provider. Uses the official endpoint unless overridden.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Optional Kimi (Moonshot AI) provider. Uses the global API endpoint unless overridden.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=

# Required to accept messages from a trusted normalized-chat source.
# Use a long, random secret; send it as the X-Ingest-Key header over HTTPS.
INGEST_API_KEY=

# Optional direct YouTube streamList ingestion and manual poll control.
# OAuth uses youtube.force-ssl so the owner can explicitly launch/end polls; it is not used for auto-moderation.
# Put the OAuth Desktop client JSON outside source control.
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=.youtube-oauth-token.json
YOUTUBE_RECONNECT_SECONDS=5
# Leave these empty to discover your active broadcast after OAuth; optional manual override:
YOUTUBE_LIVE_CHAT_ID=
YOUTUBE_BROADCAST_ID=
